<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>상품 목록</h1>
    <ul>
    <% items.forEach(item => { %>
        <% if (item.price > 150) { %>
            <li><%= item.name %> - <%= item.price %>원 - 고가 상품</li>
        <% } else { %>
            <li><%= item.name %> - <%= item.price %>원 - 저가 상품</li>
        <% } %>
        <% }) %>
    </ul>
</body>
</html>